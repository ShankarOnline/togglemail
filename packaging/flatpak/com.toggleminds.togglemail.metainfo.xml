<component type="desktop-application">
  <id>com.toggleminds.togglemail</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>ToggleMail</name>
  <summary>All your email accounts in one window</summary>
  <developer id="com.toggleminds">
    <name>Toggle Minds</name>
  </developer>

  <description>
    <p>
      ToggleMail brings all your email together: Gmail, Outlook, iCloud, Yahoo, Zoho, PhoneMail,
      Proton (through Proton Mail Bridge), mailbox.org, Posteo and your own domain &#8212; or any
      IMAP, POP3 or SMTP account.
    </p>
    <ul>
      <li>Accounts grouped by mail service, each with its folders and unread counts</li>
      <li>Inbox, Starred, Snoozed, Drafts, Scheduled, Sent, Archive, Spam, Trash and your own folders</li>
      <li>Schedule an email for later, or snooze one until you need it</li>
      <li>Safe HTML reading: scripts are removed and pictures load only from senders you allow</li>
      <li>HTML writing with attachments, links and signatures</li>
      <li>Reading pane on the right, at the bottom or off; navigation as icons</li>
      <li>Passwords kept in your keyring, never on anyone's server</li>
    </ul>
    <p>
      ToggleMail is free and open source, with no ads &#8212; a family project by Toggle Minds.
    </p>
  </description>

  <launchable type="desktop-id">com.toggleminds.togglemail.desktop</launchable>

